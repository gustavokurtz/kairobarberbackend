# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://kairobarber:kairobarber_dev@localhost:5432/kairobarber?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-min-32-chars-please-1234
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-please-12
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@kairobarber.local
RESEND_API_KEY=

# Auth
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_COST=65536

# Throttling (in-memory, MVP single instance)
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Storage
STORAGE_PROVIDER=console
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Sentry (opcional — vazio = desligado)
SENTRY_DSN=

# Redis
REDIS_URL=redis://localhost:6379

# Billing
BILLING_PROVIDER=console
BILLING_TRIAL_DAYS=14
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_SYNC_CRON=0 6,18 * * *
BILLING_TRIAL_CHECK_CRON=15 6 * * *

# Mercado Pago (only when BILLING_PROVIDER=mercadopago)
MP_ACCESS_TOKEN=
MP_PLAN_AMOUNT_CENTS=4990
MP_BILLING_FREQUENCY=months
MP_RETURN_URL=http://localhost:3001/admin/billing/return
MP_API_BASE_URL=https://api.mercadopago.com
