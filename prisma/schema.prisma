generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  saas_owner
  tenant_owner
  barber_member
  customer
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

enum OneTimeTokenPurpose {
  email_verification
  password_reset
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum AppointmentSource {
  public_storefront
  admin
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            UserRole
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownedTenant     Tenant?        @relation("TenantOwner")
  refreshTokens   RefreshToken[]
  oneTimeTokens   OneTimeToken[]
  barberProfile   Barber?        @relation("BarberUser")
  customerProfile Customer?      @relation("CustomerUser")
  auditLogs       AuditLog[]
}

model Tenant {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  bio           String?
  address       String?
  phone         String?
  avatarUrl     String?
  timezone      String    @default("America/Sao_Paulo")
  businessHours Json?
  ownerUserId   String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  suspendedAt   DateTime?

  owner             User               @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  subscription      Subscription?
  barbers           Barber[]
  services          Service[]
  photos            Photo[]
  barberInvitations BarberInvitation[]
  timeOffs          TimeOff[]
  serviceBarbers    ServiceBarber[]
  customers         Customer[]
  appointments      Appointment[]
  auditLogs         AuditLog[]

  @@index([deletedAt])
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  status               SubscriptionStatus
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  mpPreapprovalId      String?            @unique
  lastSyncedAt         DateTime?
  nextSyncAt           DateTime?
  aiQuotaUsedThisMonth Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextSyncAt])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OneTimeToken {
  id        String              @id @default(cuid())
  userId    String
  purpose   OneTimeTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Barber {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String?   @unique
  displayName String
  bio         String?
  avatarUrl   String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?             @relation("BarberUser", fields: [userId], references: [id], onDelete: SetNull)
  timeOffs       TimeOff[]
  serviceBarbers ServiceBarber[]
  photos         Photo[]
  invitation     BarberInvitation?
  appointments   Appointment[]

  @@index([tenantId, deletedAt])
}

model TimeOff {
  id        String   @id @default(cuid())
  tenantId  String
  barberId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([tenantId, barberId, startsAt])
}

model Service {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  description String?
  durationMin Int
  priceCents  Int
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceBarbers ServiceBarber[]
  photos         Photo[]
  appointments   Appointment[]

  @@index([tenantId, deletedAt])
}

model ServiceBarber {
  tenantId  String
  serviceId String
  barberId  String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@id([serviceId, barberId])
  @@index([tenantId])
}

model Photo {
  id        String    @id @default(cuid())
  tenantId  String
  r2Key     String
  caption   String?
  serviceId String?
  barberId  String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  barber  Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([tenantId, deletedAt])
}

model BarberInvitation {
  id         String    @id @default(cuid())
  tenantId   String
  barberId   String    @unique
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model Customer {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  phone               String
  email               String?
  userId              String?   @unique
  claimTokenHash      String?   @unique
  claimTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation("CustomerUser", fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([tenantId, phone], name: "tenant_phone")
  @@index([tenantId, deletedAt])
}

model Appointment {
  id                    String            @id @default(cuid())
  tenantId              String
  barberId              String
  serviceId             String
  customerId            String
  startsAt              DateTime
  endsAt                DateTime
  status                AppointmentStatus @default(pending)
  priceCentsSnapshot    Int
  durationMinSnapshot   Int
  source                AppointmentSource
  cancellationTokenHash String            @unique
  cancellationReason    String?
  cancelledAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Restrict)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId, barberId, startsAt])
  @@index([tenantId, customerId, startsAt(sort: Desc)])
  @@index([tenantId, status, startsAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String?
  actorUserId   String?
  action        String
  targetType    String?
  targetId      String?
  diff          Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}
